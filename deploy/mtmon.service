[Unit]
Description=mtmon - MikroTik realtime monitor
Documentation=file:///usr/share/doc/mtmon/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mtmon
Group=mtmon
# Self-update swap/rollback helper (deploy/apply-update.sh). "+" runs it with full privileges and outside this
# unit's sandbox (User=, ProtectSystem=strict, NoNewPrivileges ... do not apply to that one line), which is what
# lets it replace /usr/local/bin/mtmon; "-" means a missing helper or a non-zero exit never blocks the start
# (the prefixes combine, in any order). Containers installed before this feature get the helper via one normal
# installer update; until then the UI offers no "Update now".
ExecStartPre=-+/usr/local/bin/mtmon-apply-update
ExecStart=/usr/local/bin/mtmon run -c /etc/mtmon/config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
# Port >1024 by default; capability only needed if you move the UI to :443
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# Hardening. If the container refuses a sandbox option (status=226/NAMESPACE) the installer
# drops in deploy/relax.conf automatically; see docs/runbook.md
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
StateDirectory=mtmon
StateDirectoryMode=0750
ReadWritePaths=/var/lib/mtmon
UMask=0027
LimitNOFILE=8192
MemoryMax=768M

[Install]
WantedBy=multi-user.target
