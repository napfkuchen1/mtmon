[Unit]
Description=mtmon - MikroTik realtime monitor
Documentation=file:///usr/share/doc/mtmon/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mtmon
Group=mtmon
ExecStart=/usr/local/bin/mtmon run -c /etc/mtmon/config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
# Port >1024 by default; capability only needed if you move the UI to :443
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# Hardening. If the container refuses a sandbox option (status=226/NAMESPACE) the installer
# drops in deploy/relax.conf automatically; see docs/runbook.md
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
StateDirectory=mtmon
StateDirectoryMode=0750
ReadWritePaths=/var/lib/mtmon
UMask=0027
LimitNOFILE=8192
MemoryMax=768M

[Install]
WantedBy=multi-user.target
